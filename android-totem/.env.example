# ===========================================
# One-ID Totem Android - Database Configuration
# Renomeie para .env e configure os valores
# ===========================================

# PostgreSQL (Neon) Connection String
# Formato: postgresql://user:password@host/database?sslmode=require
# Obtenha em: https://console.neon.tech
# Use a mesma DATABASE_URL do .env da aplicacao web
DATABASE_URL="postgresql://user:password@ep-example-123456.sa-east-1.aws.neon.tech/fivents?sslmode=require"

# URL do modelo ArcFace ONNX (137MB, baixado na primeira execucao)
NEXT_PUBLIC_ARCFACE_ONNX_REMOTE_URL="https://huggingface.co/onnx-community/arcface-onnx/resolve/main/arcface.onnx"
